{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Multi-Agent / Multi-Model Orchestration Framework",
  "bin": {
    "agent": "src/cli/index.ts"
  },
  "scripts": {
    "dev:daemon": "node src/daemon/main.ts",
    "cli": "node src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "marked": "^12.0.2",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
